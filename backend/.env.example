# Copia este archivo como backend/.env y llena los valores. NUNCA subas .env al repositorio.
# Genera claves con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Clave para los controles del agente (iniciar, pausar, detener, liquidar, ciclo, replay).
# Se escribe en la UI en tiempo de ejecución; no se define en el frontend ni en variables VITE_*.
BACKEND_API_KEY=

# Clave que el backend usa para hablar con el gateway de Ollama (ver gateway.py).
OLLAMA_GATEWAY_API_KEY=

# Gateway autenticado y Ollama local
OLLAMA_GATEWAY_URL=http://127.0.0.1:8100
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=llama3.2:3b

# llm = el LLM propone y el motor de riesgo valida | regla = política sin LLM (umbral δ del capítulo 9)
MODO_DECISION=llm

# 1 = el LLM puede consultar herramientas de solo lectura antes de decidir (velas, historial, límites) | 0 = sin herramientas
LLM_HERRAMIENTAS=1

# Cada cuántos segundos revisa si hay una vela diaria nueva (solo decide una vez por vela)
INTERVALO_REVISION_S=300

# Opcionales
# DB_PATH=datos/agente.db
# DIR_MODELO=modelo
# RUTA_RIESGO=config/riesgo.json
# CORS_ORIGEN=http://localhost:5173
